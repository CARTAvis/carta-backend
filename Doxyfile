PROJECT_NAME           = "CARTA Backend"
PROJECT_BRIEF          = "The backend component of CARTA"
PROJECT_LOGO           = static/icons/512x512/cartaviewer.png
FULL_PATH_NAMES        = NO
EXTENSION_MAPPING      = tcc=C++
BUILTIN_STL_SUPPORT    = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_STATIC         = YES
INPUT                  = src \
                         docs/static
FILE_PATTERNS          = *.h \
                         *.cc \
                         *.tcc \
                         *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/static/main.md
VERBATIM_HEADERS       = NO
HTML_OUTPUT            = docs/html
HTML_HEADER            = docs/header.html
HTML_EXTRA_STYLESHEET  = docs/doxygen-awesome-css/doxygen-awesome.css
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
HIDE_UNDOC_RELATIONS   = NO
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_TRANSPARENT        = YES
